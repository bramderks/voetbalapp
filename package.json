  },

  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.26",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.19",
