generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id     Int     @id @default(autoincrement())
  name   String
  season String?

  players    Player[]
  activities Activity[]
}

model Player {
  id     Int    @id @default(autoincrement())
  name   String
  teamId Int

  team       Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stats      PlayerStats[]
  attendance Attendance[]
  matchStats MatchStat[]
  tactics    TacticPosition[]
}

model PlayerStats {
  id       Int @id @default(autoincrement())
  playerId Int
  goals    Int @default(0)
  assists  Int @default(0)
  present  Int @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model Activity {
  id   Int    @id @default(autoincrement())
  type String

  date      String
  startTime String
  endTime   String

  // Wedstrijd
  opponent     String?
  home         Boolean?
  scoreFor     Int?
  scoreAgainst Int?

  // Vergrendeling
  locked   Boolean   @default(false)
  lockedAt DateTime?

  // Tactiek / opstelling. Het aantal is inclusief de keeper.
  tacticPlayerCount Int @default(8)

  teamId Int
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  attendance Attendance[]
  matchStats MatchStat[]
  tactics    TacticPosition[]

  @@index([teamId])
  @@index([date])
  @@index([type])
  @@index([locked])
}

model TacticPosition {
  id         Int    @id @default(autoincrement())
  activityId Int
  playerId   Int
  zone       String @default("POOL")
  x          Float  @default(50)
  y          Float  @default(50)
  benchSlot  Int?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([activityId, playerId])
  @@index([activityId])
  @@index([playerId])
  @@index([activityId, zone])
}

model Attendance {
  id         Int     @id @default(autoincrement())
  playerId   Int
  activityId Int
  present    Boolean @default(false)

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, playerId])
  @@index([activityId])
  @@index([playerId])
}

model MatchStat {
  id         Int @id @default(autoincrement())
  playerId   Int
  activityId Int

  goals   Int @default(0)
  assists Int @default(0)

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([playerId, activityId])
  @@index([activityId])
  @@index([playerId])
}
