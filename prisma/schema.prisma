generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TEAM
// ============================================================

model Team {
  id     Int     @id @default(autoincrement())
  name   String
  season String?

  players    Player[]
  activities Activity[]
}

// ============================================================
// PLAYER
// ============================================================

model Player {
  id     Int    @id @default(autoincrement())
  name   String
  teamId Int

  team       Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stats      PlayerStats[]
  attendance Attendance[]
  matchStats MatchStat[]
  tactics    TacticPosition[]
}

// ============================================================
// PLAYER STATS
//
// BESTAANDE TABEL - voorlopig behouden.
//
// Deze tabel wordt straks niet meer gebruikt als bron voor de
// nieuwe statistieken. We verwijderen hem pas nadat de nieuwe
// statistiekenstructuur volledig werkt.
// ============================================================

model PlayerStats {
  id       Int @id @default(autoincrement())
  playerId Int
  goals    Int @default(0)
  assists  Int @default(0)
  present  Int @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ============================================================
// ACTIVITY
//
// Centrale tabel voor:
// TRAINING
// MATCH
//
// date      = YYYY-MM-DD
// startTime = HH:mm
// endTime   = HH:mm
// ============================================================

model Activity {
  id   Int    @id @default(autoincrement())
  type String

  date      String
  startTime String
  endTime   String

  // Wedstrijd
  opponent String?
  home     Boolean?

  // Vergrendeling
  locked   Boolean   @default(false)
  lockedAt DateTime?

  // Tactiek / opstelling. Het aantal is inclusief de keeper.
  tacticPlayerCount Int @default(8)

  teamId Int
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  attendance Attendance[]
  matchStats MatchStat[]
  tactics    TacticPosition[]

  @@index([teamId])
  @@index([date])
  @@index([type])
  @@index([locked])
}

// ============================================================
// TACTIC POSITION
//
// Persistente positie van een speler binnen de tactiek van een
// training. x/y zijn percentages binnen het betreffende gebied.
// zone = FIELD, BENCH of POOL.
// ============================================================

model TacticPosition {
  id         Int    @id @default(autoincrement())
  activityId Int
  playerId   Int
  zone       String @default("POOL")
  x          Float  @default(50)
  y          Float  @default(50)
  benchSlot  Int?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([activityId, playerId])
  @@index([activityId])
  @@index([playerId])
  @@index([activityId, zone])
}

// ============================================================
// ATTENDANCE
//
// Eén aanwezigheid per speler per activiteit.
//
// De unieke beperking voegen we pas toe nadat we bestaande
// dubbele records hebben gecontroleerd.
// ============================================================

model Attendance {
  id         Int     @id @default(autoincrement())
  playerId   Int
  activityId Int
  present    Boolean @default(false)

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([playerId])
}

// ============================================================
// MATCH STATISTICS
//
// Alleen voor wedstrijden.
// ============================================================

model MatchStat {
  id         Int @id @default(autoincrement())
  playerId   Int
  activityId Int

  goals   Int @default(0)
  assists Int @default(0)

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([playerId, activityId])
  @@index([activityId])
  @@index([playerId])
}
